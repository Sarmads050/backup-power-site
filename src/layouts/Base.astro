---
import '../styles/global.css';
import { SITE, NAV, url } from '../lib/site.js';

const { title, description = SITE.description, schema = null, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// While the site lives on the free preview address, keep Google out so the
// preview never competes with the real domain later.
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={url('/')}>
          <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect x="3" y="8" width="24" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="2.5"/>
            <rect x="27" y="13" width="3" height="7" rx="1" fill="currentColor"/>
            <path d="M16 11l-5 7h4l-1 5 5-7h-4z" fill="#e8a317"/>
          </svg>
          {SITE.name}
        </a>
        <nav class="site-nav" aria-label="Main">
          {NAV.map((n) => <a href={url(n.href)}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href={url('/about/')}>About</a>
          <a href={url('/contact/')}>Contact</a>
          <a href={url('/privacy-policy/')}>Privacy Policy</a>
          <a href={url('/affiliate-disclosure/')}>Affiliate Disclosure</a>
          <a href={url('/terms/')}>Terms</a>
        </nav>
        <p>© {year} {SITE.name}. Calculator results are estimates. Always check your equipment's labels and manuals before relying on backup power.</p>
      </div>
    </footer>
  </body>
</html>
